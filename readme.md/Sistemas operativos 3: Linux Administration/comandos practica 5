touch archivo_{1..100}.txt

rsync -avz -e ssh ~/sync_folder/ usuario@IP_SERVIDOR_REMOTO:/ruta/destino/

cat << 'EOF' > ~/sync_script.sh
#!/bin/bash
rsync -avz -e ssh /ruta/origen/sync_folder/ usuario@IP_SERVIDOR_REMOTO:/ruta/destino/
EOF

chmod +x ~/sync_script.sh

crontab -e
	* * * * * /bin/bash /ruta/absoluta/sync_script.sh >/dev/null 2>&1

touch ~/sync_folder/prueba_crontab.txt

